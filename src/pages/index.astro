<style is:global>
	   /* Colors and fonts */
	:root {
		--bg: #f1f6f5; /* page background */
		--surface: #ffffff; /* table and tag background */
		--ink: #0e2b2d; /* main text */
		--muted: #4f6665; /* secondary text */
		--line: #cfdddb; /* thin borders */
		--accent: #17787a; /* teal: links, buttons, highlights */
		--accent-ink: #ffffff; /* text on top of the accent color */

		--hero-bg: #17787a; /* big teal block at the top */
		--hero-ink: #f4fbfa;
		--hero-muted: #d3ecea;

		/* Test status colors. Each status also has a text label. */
		--pass: #1b7f4b;
		--fixed: #8a5a00;
		--fail: #b3261e;
		--blocked: #5f6b6a;

		--font-display: 'Bricolage Grotesque', 'Segoe UI', system-ui, sans-serif;
		--font-body: 'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
		--font-mono: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;

		--radius: 10px;
		--gutter: 1rem; /* space at the left and right edges on small screens */
		color-scheme: light dark;
	}

	/* If device is set to dark mode */
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0c1d1f;
			--surface: #13292b;
			--ink: #e6f1ef;
			--muted: #9db5b2;
			--line: #26403f;
			--accent: #5cc7c4;
			--accent-ink: #06191a;

			--hero-bg: #0f4f51;
			--hero-ink: #f1faf9;
			--hero-muted: #b9dcda;

			--pass: #4cc38a;
			--fixed: #e3b341;
			--fail: #ff8a80;
			--blocked: #9db5b2;
		}
	}

	/* Default. border-box makes width include padding */
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		-webkit-text-size-adjust: 100%;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		font-family: var(--font-body);
		font-size: 1.0625rem;
		line-height: 1.6;
	}

	h1,
	h2,
	h3,
	h4 {
		font-family: var(--font-display);
		line-height: 1.1;
		margin: 0;
		letter-spacing: -0.02em;
	}

	p {
		margin: 0;
	}

	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		color: var(--accent);
		text-underline-offset: 0.2em;
	}

	:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 3px;
		border-radius: 4px;
	}

	.wrap {
		width: min(100% - 2 * var(--gutter), 64rem);
		margin-inline: auto;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	.skip-link {
		position: absolute;
		left: var(--gutter);
		top: -4rem;
		padding: 0.6rem 1rem;
		background: var(--ink);
		color: var(--bg);
		border-radius: var(--radius);
		z-index: 10;
	}

	.skip-link:focus {
		top: var(--gutter);
	}

	/* Buttons */
	.button {
		display: inline-flex;
		align-items: center;
		padding: 0.65rem 1.1rem;
		border-radius: var(--radius);
		font-weight: 600;
		text-decoration: none;
		border: 2px solid transparent;
		transition:
			background-color 0.15s,
			color 0.15s,
			border-color 0.15s;
	}

	.button-solid {
		background: var(--accent);
		color: var(--accent-ink);
	}

	.button-solid:hover {
		background: var(--ink);
		color: var(--bg);
	}

	.button-outline {
		border-color: var(--line);
		color: var(--ink);
	}

	.button-outline:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	/* Header and navigation */
	.site-header {
		background: var(--hero-bg);
		color: var(--hero-ink);
	}

	.bar {
		display: flex; 
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-block: 1rem;
	}

	.brand {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.1rem;
		color: inherit;
		text-decoration: none;
	}

	.site-header nav ul {
		display: flex;
		gap: 1.25rem;
	}

	.site-header nav a {
		color: var(--hero-muted);
		text-decoration: none;
		font-weight: 500;
	}

	.site-header nav a:hover {
		color: var(--hero-ink);
		text-decoration: underline;
		text-underline-offset: 0.3em;
	}

	.site-header :focus-visible,
	.hero :focus-visible {
		outline-color: var(--hero-ink);
	}

	
	.hero {
		background: var(--hero-bg);
		color: var(--hero-ink);
		padding-block: clamp(3rem, 10vw, 7rem) clamp(3.5rem, 10vw, 7.5rem);
	}

	.hero h1 {
		font-size: clamp(3.25rem, 11vw, 7.5rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 0.95;
	}

	.role {
		margin-top: 1.25rem;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2.8vw, 1.75rem);
		font-weight: 500;
		color: var(--hero-muted);
	}

	.intro {
		margin-top: 1.5rem;
		max-width: 56ch;
		font-size: 1.15rem;
		line-height: 1.55;
	}

	.actions {
		display: flex;
